{
  "manifest_version": 3,
  "name": "Spy Systems Modern UI",
  "version": "1.0.0",
  "description": "Modern design overlay for Spy Systems - Gør den gamle app smuk igen!",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles/modern-overlay.css"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
